package html

import ovid/io

// Sort orders pages with Before: newest date first, missing dates last,
// equal dates by href. Heapsort runs on an array of pointers and then
// rewrites next. Inserting into the list one page at a time is quadratic
// when each new page belongs at the tail, which is what a newest-first
// directory walk does.

func Ptr(a i64, i i64) *Page {
  return load64(a + (i * 8)) as *Page
}

func SwapPtr(a i64, i i64, j i64) i64 {
  var t i64 = load64(a + (i * 8))
  store64(a + (i * 8), load64(a + (j * 8)))
  store64(a + (j * 8), t)
  return 0
}

// Sift restores the heap invariant at i. A parent sorts after its
// children, so the root is the page Before orders last.
func Sift(a i64, n i64, i i64) i64 {
  var root i64 = i
  var more bool = true
  while more {
    var left i64 = (root * 2) + 1
    var best i64 = root
    if left < n && Before(Ptr(a, best), Ptr(a, left)) {
      best = left
    }
    var right i64 = left + 1
    if right < n && Before(Ptr(a, best), Ptr(a, right)) {
      best = right
    }
    if best == root {
      more = false
    } else {
      SwapPtr(a, root, best)
      root = best
    }
  }
  return 0
}

func HeapSort(a i64, n i64) i64 {
  var i i64 = n / 2
  while i > 0 {
    i = i - 1
    Sift(a, n, i)
  }
  var end i64 = n
  while end > 1 {
    end = end - 1
    SwapPtr(a, 0, end)
    Sift(a, end, 0)
  }
  return 0
}

func Relink(a i64, n i64) *Page {
  var i i64 = 0
  while i < (n - 1) {
    var cur *Page = Ptr(a, i)
    cur.next = Ptr(a, i + 1)
    i = i + 1
  }
  var last *Page = Ptr(a, n - 1)
  last.next = 0 as *Page
  return Ptr(a, 0)
}

func Sort(io *ovid/io.Cap, head *Page, n i64) *Page {
  if n <= 1 {
    return head
  }
  var a i64 = ovid/io.Alloc(io, n * 8)
  var i i64 = 0
  var p *Page = head
  while i < n {
    store64(a + (i * 8), p as i64)
    p = p.next
    i = i + 1
  }
  HeapSort(a, n)
  return Relink(a, n)
}
