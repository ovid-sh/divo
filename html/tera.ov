package html

import bytes
import ovid/io
import ovid/mem

// Env is the template context. page is the page being written. list is
// the site list ({% for x in pages %} walks it). item is the current
// loop value, and lp/ln is the loop variable's name.
type Env struct {
  page *Page
  item *Page
  list *Page
  lp i64
  ln i64
}

// Tag is one {{ }} or {% %}. kind 1 for, 2 endfor, 3 if, 4 else, 5 endif,
// 8 expression. a is the first ident, b the field or the list name, f the
// filter. from/to cover the whole tag in the template, so an unknown tag
// can be copied through.
type Tag struct {
  kind i64
  ap i64
  an i64
  bp i64
  bn i64
  fp i64
  fn i64
  from i64
  to i64
  ok bool
}

// Part is one ident. next is the index after it.
type Part struct {
  p i64
  n i64
  next i64
  ok bool
}

// Block is the body of a for or if. hi/end bound the matching closer.
// When hasElse is set, the then-body ends at thenHi and the else-body
// runs from elseAt to hi.
type Block struct {
  hi i64
  end i64
  thenHi i64
  elseAt i64
  hasElse bool
  ok bool
}

func SkipSp(p i64, n i64, i i64) i64 {
  while i < n && bytes.IsSpace(load8(p + i)) {
    i = i + 1
  }
  return i
}

func ReadIdent(io *ovid/io.Cap, p i64, n i64, i i64) *Part {
  var part *Part = ovid/io.Alloc(io, sizeof(Part)) as *Part
  part.next = i
  if i >= n || !IsIdentStart(load8(p + i)) {
    return part
  }
  var j i64 = i + 1
  while j < n && IsIdentCont(load8(p + j)) {
    j = j + 1
  }
  part.ok = true
  part.p = p + i
  part.n = j - i
  part.next = j
  return part
}

func Kw(p i64, n i64, lit i64, ln i64) bool {
  return n == ln && ovid/mem.Eq(p, n, lit, ln)
}

func OnlySp(p i64, n i64, i i64) bool {
  return SkipSp(p, n, i) == n
}

// FillExpr parses "name", "name.field", and an optional "| filter".
func FillExpr(io *ovid/io.Cap, t *Tag, p i64, n i64) i64 {
  var i i64 = SkipSp(p, n, 0)
  var a *Part = ReadIdent(io, p, n, i)
  if !a.ok {
    return 0
  }
  t.ap = a.p
  t.an = a.n
  i = SkipSp(p, n, a.next)
  if i < n && load8(p + i) == 46 {
    i = SkipSp(p, n, i + 1)
    var field *Part = ReadIdent(io, p, n, i)
    if !field.ok {
      return 0
    }
    t.bp = field.p
    t.bn = field.n
    i = SkipSp(p, n, field.next)
  }
  if i < n && load8(p + i) == 124 {
    i = SkipSp(p, n, i + 1)
    var filt *Part = ReadIdent(io, p, n, i)
    if !filt.ok {
      return 0
    }
    t.fp = filt.p
    t.fn = filt.n
    i = SkipSp(p, n, filt.next)
  }
  if i != n {
    return 0
  }
  t.ok = true
  t.kind = 8
  return 0
}

func FillStmt(io *ovid/io.Cap, t *Tag, p i64, n i64) i64 {
  var i i64 = SkipSp(p, n, 0)
  var kw *Part = ReadIdent(io, p, n, i)
  if !kw.ok {
    return 0
  }
  if Kw(kw.p, kw.n, strptr("endfor"), 6) && OnlySp(p, n, kw.next) {
    t.kind = 2
    t.ok = true
    return 0
  }
  if Kw(kw.p, kw.n, strptr("endif"), 5) && OnlySp(p, n, kw.next) {
    t.kind = 5
    t.ok = true
    return 0
  }
  if Kw(kw.p, kw.n, strptr("else"), 4) && OnlySp(p, n, kw.next) {
    t.kind = 4
    t.ok = true
    return 0
  }
  if Kw(kw.p, kw.n, strptr("if"), 2) {
    FillExpr(io, t, p + kw.next, n - kw.next)
    if t.ok {
      t.kind = 3
    }
    return 0
  }
  if !Kw(kw.p, kw.n, strptr("for"), 3) {
    return 0
  }
  i = SkipSp(p, n, kw.next)
  var v *Part = ReadIdent(io, p, n, i)
  if !v.ok {
    return 0
  }
  i = SkipSp(p, n, v.next)
  var inn *Part = ReadIdent(io, p, n, i)
  if !inn.ok || !Kw(inn.p, inn.n, strptr("in"), 2) {
    return 0
  }
  i = SkipSp(p, n, inn.next)
  var list *Part = ReadIdent(io, p, n, i)
  if !list.ok || !OnlySp(p, n, list.next) {
    return 0
  }
  t.ap = v.p
  t.an = v.n
  t.bp = list.p
  t.bn = list.n
  t.kind = 1
  t.ok = true
  return 0
}

func FindPct(p i64, n i64, i i64) i64 {
  while (i + 1) < n {
    if load8(p + i) == 37 && load8(p + i + 1) == 125 {
      return i
    }
    i = i + 1
  }
  return -1
}

// NextStmt finds the next {% %} at or after i and before limit.
func NextStmt(io *ovid/io.Cap, tpl i64, limit i64, i i64) *Tag {
  var t *Tag = ovid/io.Alloc(io, sizeof(Tag)) as *Tag
  t.from = -1
  while (i + 1) < limit {
    var open bool = load8(tpl + i) == 123 && load8(tpl + i + 1) == 37
    if open {
      var j i64 = FindPct(tpl, limit, i + 2)
      t.from = i
      if j < 0 {
        t.to = i + 1
        return t
      }
      t.to = j + 2
      var inner *bytes.Span = bytes.Trim(io, (tpl + i) + 2, j - (i + 2))
      FillStmt(io, t, inner.p, inner.n)
      return t
    }
    i = i + 1
  }
  return t
}

// TakeBlock finds the closer of the for or if that just opened.
// Search starts at i, already inside the body, with depth 1.
func TakeBlock(io *ovid/io.Cap, tpl i64, limit i64, i i64) *Block {
  var blk *Block = ovid/io.Alloc(io, sizeof(Block)) as *Block
  var depth i64 = 1
  while i < limit && !blk.ok {
    var t *Tag = NextStmt(io, tpl, limit, i)
    if t.from < 0 {
      i = limit
    } else if !t.ok {
      if t.to > t.from {
        i = t.to
      } else {
        i = t.from + 1
      }
    } else if t.kind == 1 || t.kind == 3 {
      depth = depth + 1
      i = t.to
    } else if t.kind == 2 || t.kind == 5 {
      depth = depth - 1
      if depth == 0 {
        blk.hi = t.from
        blk.end = t.to
        blk.ok = true
      }
      i = t.to
    } else if t.kind == 4 && depth == 1 && !blk.hasElse {
      blk.thenHi = t.from
      blk.elseAt = t.to
      blk.hasElse = true
      i = t.to
    } else {
      i = t.to
    }
  }
  return blk
}

func Pick(env *Env, a i64, an i64) *Page {
  var loop bool = env.item != 0 as *Page && ovid/mem.Eq(a, an, env.lp, env.ln)
  if loop {
    return env.item
  }
  if ovid/mem.Eq(a, an, strptr("page"), 4) {
    return env.page
  }
  return 0 as *Page
}

func EmitExpr(io *ovid/io.Cap, b *ovid/mem.Buf, env *Env, tpl i64, t *Tag) i64 {
  var slot *Slot = 0 as *Slot
  if t.bn == 0 {
    slot = Lookup(io, env.page, t.ap, t.an)
  } else {
    var pg *Page = Pick(env, t.ap, t.an)
    if pg == 0 as *Page {
      ovid/mem.WBytes(io, b, tpl + t.from, t.to - t.from)
      return 0
    }
    slot = Lookup(io, pg, t.bp, t.bn)
  }
  if !slot.ok {
    ovid/mem.WBytes(io, b, tpl + t.from, t.to - t.from)
    return 0
  }
  var raw bool = slot.raw
  if t.fn > 0 {
    if Kw(t.fp, t.fn, strptr("safe"), 4) {
      raw = true
    } else if Kw(t.fp, t.fn, strptr("escape"), 6) {
      raw = false
    } else {
      ovid/mem.WBytes(io, b, tpl + t.from, t.to - t.from)
      return 0
    }
  }
  if raw {
    ovid/mem.WBytes(io, b, slot.p, slot.n)
  } else {
    Escape(io, b, slot.p, slot.n)
  }
  return 0
}

func Truth(io *ovid/io.Cap, env *Env, t *Tag) bool {
  if t.bn == 0 {
    var named bool = env.item != 0 as *Page && ovid/mem.Eq(t.ap, t.an, env.lp, env.ln)
    if named {
      return true
    }
    var slot *Slot = Lookup(io, env.page, t.ap, t.an)
    return slot.ok && slot.n > 0
  }
  var pg *Page = Pick(env, t.ap, t.an)
  if pg == 0 as *Page {
    return false
  }
  var slot *Slot = Lookup(io, pg, t.bp, t.bn)
  return slot.ok && slot.n > 0
}

func RenderTo(io *ovid/io.Cap, tpl i64, lo i64, hi i64, env *Env, b *ovid/mem.Buf) i64 {
  var i i64 = lo
  while i < hi {
    var two bool = (i + 1) < hi
    var expr bool = two && load8(tpl + i) == 123 && load8(tpl + i + 1) == 123
    var stmt bool = two && load8(tpl + i) == 123 && load8(tpl + i + 1) == 37
    if expr {
      var j i64 = FindBrace(tpl, hi, i + 2)
      if j < 0 {
        ovid/mem.WBytes(io, b, tpl + i, hi - i)
        i = hi
      } else {
        var t *Tag = ovid/io.Alloc(io, sizeof(Tag)) as *Tag
        t.from = i
        t.to = j + 2
        var inner *bytes.Span = bytes.Trim(io, (tpl + i) + 2, j - (i + 2))
        FillExpr(io, t, inner.p, inner.n)
        if t.ok {
          EmitExpr(io, b, env, tpl, t)
        } else {
          ovid/mem.WBytes(io, b, tpl + i, t.to - i)
        }
        i = t.to
      }
    } else if stmt {
      var j i64 = FindPct(tpl, hi, i + 2)
      if j < 0 {
        ovid/mem.WBytes(io, b, tpl + i, hi - i)
        i = hi
      } else {
        var t *Tag = ovid/io.Alloc(io, sizeof(Tag)) as *Tag
        t.from = i
        t.to = j + 2
        var inner *bytes.Span = bytes.Trim(io, (tpl + i) + 2, j - (i + 2))
        FillStmt(io, t, inner.p, inner.n)
        if t.kind == 1 && t.ok {
          var blk *Block = TakeBlock(io, tpl, hi, t.to)
          if !blk.ok {
            ovid/mem.WBytes(io, b, tpl + i, hi - i)
            i = hi
          } else {
            var pages bool = Kw(t.bp, t.bn, strptr("pages"), 5)
            if pages {
              var old *Page = env.item
              var oldp i64 = env.lp
              var oldn i64 = env.ln
              env.lp = t.ap
              env.ln = t.an
              env.item = env.list
              while env.item != 0 as *Page {
                RenderTo(io, tpl, t.to, blk.hi, env, b)
                env.item = env.item.next
              }
              env.item = old
              env.lp = oldp
              env.ln = oldn
            }
            i = blk.end
          }
        } else if t.kind == 3 && t.ok {
          var blk *Block = TakeBlock(io, tpl, hi, t.to)
          if !blk.ok {
            ovid/mem.WBytes(io, b, tpl + i, hi - i)
            i = hi
          } else {
            var yes bool = Truth(io, env, t)
            if yes {
              var endThen i64 = blk.hi
              if blk.hasElse {
                endThen = blk.thenHi
              }
              RenderTo(io, tpl, t.to, endThen, env, b)
            } else if blk.hasElse {
              RenderTo(io, tpl, blk.elseAt, blk.hi, env, b)
            }
            i = blk.end
          }
        } else {
          ovid/mem.WBytes(io, b, tpl + t.from, t.to - t.from)
          i = t.to
        }
      }
    } else {
      ovid/mem.WByte(io, b, load8(tpl + i))
      i = i + 1
    }
  }
  return 0
}

// Apply fills a Tera slice. {{name}} and {{name | escape}} are escaped,
// {{name | safe}} is not, and body and pages are raw unless a filter says
// otherwise. {% if %} tests that a value is non-empty. {% for name in pages %}
// walks the site list. An unknown tag is left as written.
func Apply(io *ovid/io.Cap, tpl i64, tpln i64, page *Page) *ovid/mem.Buf {
  var env *Env = ovid/io.Alloc(io, sizeof(Env)) as *Env
  env.page = page
  env.list = page.list
  var b *ovid/mem.Buf = ovid/mem.New(io, (tpln + page.bodyn) + 128)
  RenderTo(io, tpl, 0, tpln, env, b)
  return b
}
